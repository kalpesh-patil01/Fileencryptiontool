<?xml version="1.0" encoding="UTF-8"?>
<!-- Servlet 4.0 deployment descriptor (Tomcat 9). Servlets are mapped with @WebServlet,
     so this file only holds the welcome page and the generic error pages. -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>File Encryption and Decryption Tool</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Any unexpected exception shows a friendly page instead of a Java stack trace -->
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/result.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/result.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/result.jsp</location>
    </error-page>
</web-app>
